# ==================================================
# vpn-private-poster — переменные окружения
# Скопируйте в .env и заполните реальными значениями.
# НИКОГДА не коммитьте .env с реальными значениями.
# ==================================================

# AI (используется AI-контуром, см. src/ai_client.py)
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1

# Модели
MODEL_PRIMARY=openai/gpt-oss-120b
MODEL_FALLBACK=openai/gpt-oss-20b

MODEL_BLOCK_PRIMARY=openai/gpt-oss-120b
MODEL_BLOCK_FALLBACK=groq/compound
MODEL_BLOCK_OPTIONAL=qwen/qwen3.6-27b

MODEL_SCOUT_PRIMARY=openai/gpt-oss-120b
MODEL_SCOUT_FALLBACK=openai/gpt-oss-20b

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_PRIVATE_CHANNEL=

# GitHub (токен с правами на push в репозиторий)
GH_TOKEN=

# Runtime
# 1 = не отправлять сообщения в Telegram, не пушить в GitHub
TELEGRAM_DRY_RUN=1
# 1 = AI-черновики отправляются только администратору на проверку
ADMIN_REVIEW_REQUIRED=1
# 0 = AI-посты не публикуются в канал автоматически
AUTO_PUBLISH=0

# Poster (переопределяют config/settings.yaml)
# MAX_KEYS_TO_CHECK=1000
# MAX_WORKERS=20
# TCP_TIMEOUT=3
# XRAY_TIMEOUT=8
# MIN_PUBLISH_COUNT=3
# REPLACE_HOSTS=0
# XRAY_BIN=./bin/xray
